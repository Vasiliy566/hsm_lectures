# Скопируйте в .env и впишите ключ. Файл .env не отправляйте в git, чат и на скриншоты.
OPENAI_API_KEY=sk-...
# Модель с поддержкой function calling и structured outputs. Преподаватель пришлёт проверенное имя.
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL нужен только для не-OpenAI сервиса с совместимым API.
