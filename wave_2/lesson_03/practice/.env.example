# Скопируйте в .env и впишите ключ. Файл .env не отправляйте в git, чат и на скриншоты.
OPENAI_API_KEY=sk-...
# Модель с поддержкой function calling. Преподаватель пришлёт проверенное имя.
OPENAI_MODEL=gpt-6-luna
# Модель эмбеддингов для поиска по смыслу.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
