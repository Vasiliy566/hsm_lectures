# Скопируйте этот файл в .env и впишите свой ключ. Файл .env не отправляйте в git и в чаты.

# Ключ OpenAI API: platform.openai.com → API keys. Поставьте на проект лимит расходов.
OPENAI_API_KEY=sk-...

# Модель OpenAI. Преподаватель пришлёт проверенное имя.
OPENAI_MODEL=gpt-6-luna

# Необязательно: цены за 1 млн токенов, чтобы скрипт 02 считал стоимость
# (для gpt-6-luna по странице моделей OpenAI: вход 0.1, выход 0.5 — проверьте актуальность)
PRICE_IN_PER_M=0.1
PRICE_OUT_PER_M=0.5
