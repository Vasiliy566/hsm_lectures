# Не записывайте настоящий ключ в этот файл и не коммитьте .env.

# Вариант 1: официальный OpenAI API
LLM_API_KEY=replace_me_locally
LLM_MODEL=gpt-5.6

# Вариант 2: корпоративный или OpenAI-compatible endpoint
# Проверьте, поддерживает ли он Responses API или только Chat Completions.
# LLM_BASE_URL=https://example.org/v1
# LLM_API_KEY=replace_me_locally
# LLM_MODEL=provider_model_name

# Для локального endpoint ключ может быть фиктивной непустой строкой:
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=local-not-a-secret
# LLM_MODEL=local_model_name
